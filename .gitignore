# Ignore Python cache
__pycache__/
*.py[cod]
*.so
*.pyd

# Ignore virtual environment
myenv/

# Ignore VSCode settings (optional)
.vscode/

# Ignore Jupyter notebook checkpoints (if used)
.ipynb_checkpoints/

# Ignore OS/system files
.DS_Store
Thumbs.db

# Ignore logs, data dumps
*.log
*.tmp

# ── Datasets (large, regenerable from scripts/labeling/) ─────────────
# top-level dataset folders (only at repo root)
/images/
/labels/
/runs/
/preds/
/Vehicle_type_detection/images/
/Vehicle_type_detection/labels/

# labeling work areas
Labeling/images_to_label/
Labeling/labels/
Labeling/preview/
Labeling/quarantine_branchB_yolov8n/

flight_logs/*.mp4

# Ignore backup folders created by scripts/operations
backups/
images_backup_*/
labels_backup_*/
devkit/
devkit/*

# dataset media — deliberately untracked (see commit c0e56ff); re-fetch with
# scripts/labeling/download_kaggle.py
Labeling/kaggle_dataset/train/
Labeling/kaggle_dataset/valid/
Labeling/kaggle_dataset/test/

# ── Weights ──────────────────────────────────────────────────────────
# Pretrained backbones are downloadable; only these two were already
# untracked, kept that way to avoid growing the (already ~1.2GB) history.
weights/pretrained/yolov8s.pt
weights/pretrained/yolov8s-seg.pt

# Class-name-retagged checkpoint copies (~600MB). Regenerate in seconds with
# scripts/tools/retag_checkpoint.py --all
*_vehicle.pt

# Legacy scratch folder, superseded by weights/ + scripts/
/YoloModel/

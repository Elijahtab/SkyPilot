# Workstation image: x86_64, no GPU assumed. What a teammate develops in.
# Build context is the repo root.
FROM ros:humble-ros-base

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        git \
        python3-pip \
        python3-colcon-common-extensions \
        ros-humble-cv-bridge \
        ros-humble-image-transport \
        ros-humble-rosbag2-storage-mcap \
        ros-humble-rmw-cyclonedds-cpp \
    && rm -rf /var/lib/apt/lists/*

# CPU torch first, so the ultralytics install below finds its torch
# requirement already satisfied and does not pull the CUDA build (2 GB) onto
# a laptop that cannot use it.
RUN pip3 install --no-cache-dir \
        torch==2.7.1 torchvision==0.22.1 \
        --index-url https://download.pytorch.org/whl/cpu

COPY docker/requirements-ros.txt /tmp/requirements-ros.txt
RUN pip3 install --no-cache-dir -r /tmp/requirements-ros.txt

# rmw_cyclonedds_cpp is installed but not selected. Humble's default is Fast
# DDS; switch with RMW_IMPLEMENTATION=rmw_cyclonedds_cpp if multi-machine
# discovery misbehaves, and set it identically on every machine if you do.
ENV SKYPILOT_REPO=/workspace
WORKDIR /workspace

RUN echo 'source /opt/ros/humble/setup.bash' >> /root/.bashrc \
 && echo '[ -f /workspace/ros2_ws/install/setup.bash ] && source /workspace/ros2_ws/install/setup.bash' >> /root/.bashrc
